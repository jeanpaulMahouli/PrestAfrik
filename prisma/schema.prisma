generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WhatsappMode {
  WA_ME
  CLOUD_API
}

enum WhatsappApiStatus {
  NOT_CONFIGURED
  PENDING_TEST
  CONNECTED
  FAILED
}

enum PlatformRole {
  USER
  /// Accès à l'administration, sans gestion des administrateurs.
  ADMIN
  /// Administrateur qui peut aussi donner ou retirer les droits d'administration.
  SUPER_ADMIN
}

enum StoreRole {
  OWNER
  MANAGER
  ORDER_PREPARER
}

enum StoreTheme {
  CATALOGUE_EXPRESS
  MODE_BEAUTE
  BOUTIQUE_MARQUE
  GRAND_MARCHE
}

/// Présentation de la rangée « Promotions » de la vitrine (Ma boutique → Apparence).
enum StorePromoStyle {
  CLASSIQUE
  VENTE_FLASH
  OFFRES_DU_JOUR
  ECLAT
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum ProductAvailability {
  AVAILABLE
  SOLD_OUT
  PREORDER
}

enum OrderConfirmationStatus {
  PENDING
  CONFIRMED
  CHANGE_REQUESTED
  DECLINED
  EXPIRED
}

enum OrderProcessingStatus {
  TO_REVIEW
  ACCEPTED
  PREPARING
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  TO_ORGANIZE
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
  PICKUP
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentType {
  PAYMENT_RECEIVED
  PARTIAL_PAYMENT
  COURIER_COLLECTION
  SETTLEMENT
  REFUND
  REVERSAL
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  OTHER
}

enum ConsentType {
  ORDER_FOLLOW_UP
  MARKETING
}

enum MarketingCampaignStatus {
  DRAFT
  /// Envoi commencé (destinataires choisis) ; certains messages peuvent rester à envoyer.
  PROCESSING
  /// Ancien mode simulation : aucun message réel n'est parti.
  SIMULATED
  /// Tous les destinataires ont été traités (envoyés ou en échec).
  SENT
}

/// Envoi d'un message de campagne à un client.
enum MarketingDeliveryStatus {
  PENDING
  SENT
  FAILED
  /// Ancien mode simulation.
  SIMULATED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELED
}

enum SubscriptionPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

model User {
  id                         String                 @id @default(cuid())
  name                       String
  /// Comptes créés par WhatsApp : adresse technique en « .invalid » (aucun e-mail n'y est envoyé).
  email                      String                 @unique
  emailVerified              Boolean                @default(false)
  /// Numéro WhatsApp du compte (E.164), demandé à l'inscription. phoneNumberVerified : confirmé par un code
  /// WhatsApp (inscription par WhatsApp, désactivée pour le moment).
  phoneNumber                String?                @unique @db.VarChar(20)
  phoneNumberVerified        Boolean                @default(false)
  image                      String?
  platformRole               PlatformRole           @default(USER)
  /// Accès suspendu par l'administration : aucune nouvelle session n'est ouverte.
  suspendedAt                DateTime?
  suspensionReason           String?                @db.VarChar(300)
  /// Dernière boutique ouverte dans le tableau de bord : retrouvée à la prochaine connexion, sur tout appareil.
  lastActiveStoreId          String?
  lastActiveStore            Store?                 @relation("UserLastActiveStore", fields: [lastActiveStoreId], references: [id], onDelete: SetNull)
  /// Dernière activité dans l'espace vendeur (mise à jour au plus une fois toutes les 5 minutes).
  lastActiveAt               DateTime?
  supportTickets             SupportTicket[]        @relation("SupportTicketRequester")
  assignedTickets            SupportTicket[]        @relation("SupportTicketAssignee")
  supportReplies             SupportTicketMessage[]
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  accounts                   Account[]
  sessions                   Session[]
  memberships                StoreMembership[]
  invitations                StoreInvitation[]      @relation("InvitationSender")
  acceptedInvites            StoreInvitation[]      @relation("InvitationRecipient")
  authoredPayments           Payment[]
  authoredCustomerNotes      CustomerNote[]         @relation("CustomerNoteAuthor")
  authoredCustomerReminders  CustomerReminder[]     @relation("CustomerReminderAuthor")
  authoredMarketingCampaigns MarketingCampaign[]    @relation("MarketingCampaignAuthor")
  storeDrafts                StoreDraft[]
  auditLogs                  AuditLog[]             @relation("AuditLogActor")
  adminAlertStates           AdminAlertState[]      @relation("AdminAlertStateAuthor")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum PhoneVerificationPurpose {
  SIGN_UP
  PASSWORD_RESET
}

/// Code à usage unique envoyé sur WhatsApp (inscription, mot de passe oublié). Une seule ligne par numéro
/// et par usage : recommencer ou actualiser la page réutilise la même demande, sans doublon.
/// Le code n'est jamais stocké en clair (HMAC), le mot de passe d'inscription est déjà haché.
model PhoneVerification {
  id              String                   @id @default(cuid())
  purpose         PhoneVerificationPurpose
  phoneNumber     String                   @db.VarChar(20)
  /// Inscription : nom et mot de passe haché, utilisés à la création du compte une fois le code vérifié.
  name            String?                  @db.VarChar(80)
  passwordHash    String?
  codeHash        String                   @db.VarChar(64)
  expiresAt       DateTime
  /// Codes faux saisis pour le code en cours (remis à zéro à chaque nouveau code).
  attempts        Int                      @default(0)
  /// Codes envoyés depuis windowStartedAt (limite par 24 h).
  sendCount       Int                      @default(1)
  windowStartedAt DateTime                 @default(now())
  lastSentAt      DateTime                 @default(now())
  consumedAt      DateTime?
  /// Identifiant du message chez Meta (wamid) : le webhook y rattache le statut de distribution.
  messageId       String?                  @db.VarChar(128)
  deliveryStatus  String?                  @db.VarChar(20)
  deliveryError   String?                  @db.VarChar(200)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([purpose, phoneNumber])
  @@index([messageId])
}

/// Boutique en cours de création (assistant). Aucune boutique n'existe tant que l'assistant n'est pas terminé :
/// les réponses sont gardées ici, puis la boutique est créée à la dernière étape avec le même identifiant
/// (les photos et le logo envoyés pendant l'assistant restent donc valides).
model StoreDraft {
  id        String   @id @default(cuid())
  userId    String
  /// Dernière étape atteinte (1 à 8).
  step      Int      @default(1)
  /// Réponses de l'assistant (voir src/modules/stores/draft.ts).
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model Store {
  id                 String                 @id @default(cuid())
  name               String
  slug               String                 @unique
  businessCategory   String?
  activityId         String?
  activityOther      String?                @db.VarChar(80)
  country            String                 @default("CM") @db.VarChar(2)
  region             String?                @db.VarChar(80)
  city               String?
  neighborhood       String?                @db.VarChar(80)
  contactPhone       String?
  phoneCountry       String?                @db.VarChar(2)
  phoneNational      String?                @db.VarChar(20)
  phoneE164          String?                @db.VarChar(20)
  contactEmail       String?                @db.VarChar(254)
  address            String?                @db.VarChar(200)
  pickupEnabled      Boolean                @default(true)
  pickupAddress      String?                @db.VarChar(200)
  pickupHours        String?                @db.VarChar(120)
  /// Étape en cours de l'assistant de création (1 à 8) ; null quand l'assistant est terminé.
  onboardingStep     Int?
  publishedAt        DateTime?
  suspendedAt        DateTime?
  suspensionReason   String?                @db.VarChar(300)
  /// Avis clients sur les fiches produit (le vendeur peut les désactiver).
  reviewsEnabled     Boolean                @default(true)
  theme              StoreTheme             @default(CATALOGUE_EXPRESS)
  promoStyle         StorePromoStyle        @default(CLASSIQUE)
  isPublished        Boolean                @default(false)
  description        String?                @db.VarChar(2000)
  logoUrl            String?
  bannerUrl          String?
  primaryColor       String                 @default("#FF9900") @db.VarChar(7)
  secondaryColor     String                 @default("#000026") @db.VarChar(7)
  accentColor        String                 @default("#EF765E") @db.VarChar(7)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  memberships        StoreMembership[]
  invitations        StoreInvitation[]
  categories         ProductCategory[]
  products           Product[]
  customers          Customer[]
  customerNotes      CustomerNote[]
  customerReminders  CustomerReminder[]
  orders             Order[]
  deliveryZones      DeliveryZone[]
  consents           CustomerConsent[]
  outboxEvents       OutboxEvent[]
  rateLimitBuckets   StoreRateLimitBucket[]
  couriers           Courier[]
  deliveries         Delivery[]
  payments           Payment[]
  marketingCampaigns MarketingCampaign[]
  subscription       Subscription?
  whatsappSettings   WhatsappSettings?
  activity           Activity?              @relation(fields: [activityId], references: [id], onDelete: SetNull)
  chatConfig         StoreChatConfig?
  chatQuickReplies   StoreChatQuickReply[]
  pages              StorePage[]
  reviews            ProductReview[]
  slugAliases        StoreSlugAlias[]
  banners            StoreBanner[]
  supportTickets     SupportTicket[]
  popups             StorePopup[]
  lastActiveUsers    User[]                 @relation("UserLastActiveStore")
  visitDays          StoreVisitDay[]
}

model StoreMembership {
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  role      StoreRole @default(OWNER)
  createdAt DateTime  @default(now())
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
}

model StoreInvitation {
  id           String    @id @default(cuid())
  storeId      String
  email        String
  role         StoreRole
  token        String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  invitedById  String
  acceptedById String?
  createdAt    DateTime  @default(now())
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invitedBy    User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy   User?     @relation("InvitationRecipient", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([storeId, email])
  @@index([token, expiresAt])
}

model LocalEmailMessage {
  id        String   @id @default(cuid())
  recipient String
  subject   String
  url       String
  createdAt DateTime @default(now())

  @@index([recipient, createdAt])
}

model ProductCategory {
  id        String        @id @default(cuid())
  storeId   String
  name      String        @db.VarChar(80)
  slug      String        @db.VarChar(90)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]
  banners   StoreBanner[]
  popups    StorePopup[]

  @@unique([storeId, slug])
  @@unique([storeId, name])
  @@index([storeId, sortOrder])
}

model Product {
  id                  String              @id @default(cuid())
  storeId             String
  categoryId          String?
  name                String              @db.VarChar(140)
  slug                String              @db.VarChar(160)
  sku                 String              @db.VarChar(48)
  description         String?             @db.VarChar(4000)
  priceXaf            Int
  promotionalPriceXaf Int?
  availability        ProductAvailability @default(AVAILABLE)
  trackInventory      Boolean             @default(false)
  stockQuantity       Int?
  reservedQuantity    Int                 @default(0)
  isFeatured          Boolean             @default(false)
  status              ProductStatus       @default(ACTIVE)
  archivedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  store               Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category            ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images              ProductImage[]
  variants            ProductVariant[]
  orderItems          OrderItem[]
  reservations        StockReservation[]
  reviews             ProductReview[]
  banners             StoreBanner[]
  popups              StorePopup[]

  @@unique([storeId, sku])
  @@unique([storeId, slug])
  @@index([storeId, status, availability, createdAt])
  @@index([storeId, categoryId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?  @db.VarChar(200)
  /// 0 = photo principale ; 5 photos au maximum (contrainte CHECK en base).
  position  Int      @db.SmallInt
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
}

model ProductVariant {
  id               String             @id @default(cuid())
  productId        String
  sku              String             @db.VarChar(48)
  optionName       String             @db.VarChar(60)
  optionValue      String             @db.VarChar(80)
  priceXaf         Int?
  stockQuantity    Int?
  reservedQuantity Int                @default(0)
  isArchived       Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  product          Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
  reservations     StockReservation[]

  @@unique([productId, sku])
  @@unique([productId, optionName, optionValue])
  @@index([productId, isArchived])
}

model Customer {
  id                 String                       @id @default(cuid())
  storeId            String
  name               String                       @db.VarChar(120)
  whatsapp           String                       @db.VarChar(20)
  email              String?                      @db.VarChar(254)
  firstOrderAt       DateTime?
  lastOrderAt        DateTime?
  orderCount         Int                          @default(0)
  source             String                       @default("storefront") @db.VarChar(24)
  nameConflict       Boolean                      @default(false)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  store              Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders             Order[]
  addresses          CustomerAddress[]
  consents           CustomerConsent[]
  tags               CustomerTag[]
  notes              CustomerNote[]
  reminders          CustomerReminder[]
  campaignRecipients MarketingCampaignRecipient[]

  @@unique([storeId, whatsapp])
  @@index([storeId, name])
  @@index([storeId, lastOrderAt])
}

model CustomerAddress {
  id           String   @id @default(cuid())
  customerId   String
  city         String   @db.VarChar(100)
  neighborhood String?  @db.VarChar(120)
  landmark     String?  @db.VarChar(250)
  lastUsedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, lastUsedAt])
}

model CustomerConsent {
  id         String      @id @default(cuid())
  storeId    String
  customerId String
  type       ConsentType
  granted    Boolean
  source     String      @db.VarChar(40)
  recordedAt DateTime    @default(now())
  revokedAt  DateTime?
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId, customerId, type, recordedAt])
}

model CustomerTag {
  id         String   @id @default(cuid())
  customerId String
  name       String   @db.VarChar(40)
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, name])
  @@index([name])
}

model CustomerNote {
  id         String   @id @default(cuid())
  storeId    String
  customerId String
  authorId   String
  content    String   @db.VarChar(1000)
  createdAt  DateTime @default(now())
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author     User     @relation("CustomerNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([storeId, customerId, createdAt])
}

model CustomerReminder {
  id          String    @id @default(cuid())
  storeId     String
  customerId  String
  authorId    String
  remindAt    DateTime
  reason      String    @db.VarChar(250)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author      User      @relation("CustomerReminderAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([storeId, completedAt, remindAt])
  @@index([customerId, completedAt, remindAt])
}

model MarketingCampaign {
  id             String                       @id @default(cuid())
  storeId        String
  createdById    String
  name           String                       @db.VarChar(100)
  audience       String                       @db.VarChar(24)
  message        String                       @db.VarChar(1000)
  recipientLimit Int
  status         MarketingCampaignStatus      @default(DRAFT)
  simulatedAt    DateTime?
  sentAt         DateTime?
  sentCount      Int                          @default(0)
  failedCount    Int                          @default(0)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  store          Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy      User                         @relation("MarketingCampaignAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  recipients     MarketingCampaignRecipient[]

  @@index([storeId, createdAt])
  @@index([storeId, status, createdAt])
}

model MarketingCampaignRecipient {
  id          String                  @id @default(cuid())
  campaignId  String
  customerId  String
  whatsapp    String                  @db.VarChar(20)
  /// Date de sélection du destinataire (compte dans le quota mensuel de messages).
  simulatedAt DateTime                @default(now())
  status      MarketingDeliveryStatus @default(PENDING)
  sentAt      DateTime?
  /// Identifiant du message renvoyé par WhatsApp (wamid…).
  waMessageId String?                 @db.VarChar(128)
  error       String?                 @db.VarChar(300)
  campaign    MarketingCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer    Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
  @@index([campaignId, simulatedAt])
  @@index([campaignId, status])
}

model Plan {
  id                     String         @id @default(cuid())
  code                   String         @unique @db.VarChar(24)
  name                   String         @db.VarChar(60)
  monthlyPriceXaf        Int
  yearlyPriceXaf         Int
  productQuota           Int?
  monthlyMessageQuota    Int
  memberQuota            Int
  recommended            Boolean        @default(false)
  active                 Boolean        @default(true)
  sortOrder              Int            @default(0)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  subscriptions          Subscription[] @relation("SubscriptionPlan")
  scheduledSubscriptions Subscription[] @relation("ScheduledSubscriptionPlan")

  @@index([active, sortOrder])
}

model Subscription {
  id                 String                @id @default(cuid())
  storeId            String                @unique
  planId             String
  scheduledPlanId    String?
  status             SubscriptionStatus    @default(TRIAL)
  billingPeriod      SubscriptionPeriod?
  trialStartedAt     DateTime
  trialEndsAt        DateTime
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  scheduledAt        DateTime?
  canceledAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  store              Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan               Plan                  @relation("SubscriptionPlan", fields: [planId], references: [id], onDelete: Restrict)
  scheduledPlan      Plan?                 @relation("ScheduledSubscriptionPlan", fields: [scheduledPlanId], references: [id], onDelete: Restrict)
  payments           SubscriptionPayment[]

  @@index([status, trialEndsAt])
  @@index([status, currentPeriodEnd])
}

model SubscriptionPayment {
  id             String                    @id @default(cuid())
  subscriptionId String
  provider       String                    @db.VarChar(32)
  providerRef    String?                   @db.VarChar(120)
  eventId        String                    @unique @db.VarChar(120)
  amountXaf      Int
  period         SubscriptionPeriod
  status         SubscriptionPaymentStatus @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime                  @default(now())
  subscription   Subscription              @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
}

model DeliveryZone {
  id                   String   @id @default(cuid())
  storeId              String
  city                 String   @db.VarChar(100)
  name                 String   @db.VarChar(120)
  feeXaf               Int?
  estimatedDelay       String?  @db.VarChar(100)
  requiresConfirmation Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders               Order[]

  @@unique([storeId, city, name])
  @@index([storeId, city, isActive])
}

model Courier {
  id         String     @id @default(cuid())
  storeId    String
  name       String     @db.VarChar(120)
  phone      String     @db.VarChar(20)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deliveries Delivery[]
  payments   Payment[]

  @@unique([storeId, phone])
  @@index([storeId, isActive, name])
}

model Delivery {
  id            String         @id @default(cuid())
  storeId       String
  orderId       String         @unique
  courierId     String?
  status        DeliveryStatus @default(TO_ORGANIZE)
  failureReason String?        @db.VarChar(500)
  assignedAt    DateTime?
  pickedUpAt    DateTime?
  deliveredAt   DateTime?
  returnedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier       Courier?       @relation(fields: [courierId], references: [id], onDelete: SetNull)

  @@index([storeId, status, updatedAt])
  @@index([courierId, status])
}

model Payment {
  id         String        @id @default(cuid())
  storeId    String
  orderId    String
  authorId   String
  courierId  String?
  type       PaymentType
  method     PaymentMethod
  amountXaf  Int
  reference  String?       @db.VarChar(120)
  note       String?       @db.VarChar(500)
  reversesId String?       @unique
  /// Date réelle de l'encaissement (jamais future) ; createdAt reste la date de saisie.
  receivedAt DateTime      @default(now())
  createdAt  DateTime      @default(now())
  store      Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  author     User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  courier    Courier?      @relation(fields: [courierId], references: [id], onDelete: SetNull)
  reverses   Payment?      @relation("PaymentReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy Payment?      @relation("PaymentReversal")

  @@index([storeId, createdAt])
  @@index([storeId, orderId, createdAt])
  @@index([courierId, createdAt])
  @@index([storeId, receivedAt])
}

model Order {
  id                 String                  @id @default(cuid())
  storeId            String
  customerId         String
  deliveryZoneId     String?
  reference          String                  @db.VarChar(32)
  idempotencyKey     String                  @db.VarChar(80)
  trackingToken      String                  @unique @db.VarChar(80)
  customerName       String                  @db.VarChar(120)
  customerWhatsapp   String                  @db.VarChar(20)
  customerEmail      String?                 @db.VarChar(254)
  deliveryCity       String                  @db.VarChar(100)
  neighborhood       String?                 @db.VarChar(120)
  landmark           String?                 @db.VarChar(250)
  deliveryMethod     String                  @db.VarChar(20)
  deliveryComment    String?                 @db.VarChar(500)
  deliveryFeeXaf     Int?
  subtotalXaf        Int
  totalXaf           Int?
  confirmationStatus OrderConfirmationStatus @default(PENDING)
  processingStatus   OrderProcessingStatus   @default(TO_REVIEW)
  deliveryStatus     DeliveryStatus          @default(TO_ORGANIZE)
  paymentStatus      PaymentStatus           @default(PENDING)
  followUpConsent    Boolean
  marketingConsent   Boolean                 @default(false)
  expiresAt          DateTime
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  store              Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer           Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  deliveryZone       DeliveryZone?           @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  reservations       StockReservation[]
  events             OrderEvent[]
  delivery           Delivery?
  payments           Payment[]

  @@unique([storeId, reference])
  @@unique([storeId, idempotencyKey])
  @@index([storeId, createdAt])
  @@index([storeId, confirmationStatus, createdAt])
  @@index([storeId, processingStatus, createdAt])
  @@index([storeId, deliveryStatus, createdAt])
}

model OrderItem {
  id           String             @id @default(cuid())
  orderId      String
  productId    String?
  variantId    String?
  productName  String             @db.VarChar(140)
  variantName  String?            @db.VarChar(160)
  sku          String             @db.VarChar(48)
  quantity     Int
  unitPriceXaf Int
  lineTotalXaf Int
  product      Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reservations StockReservation[]

  @@index([orderId])
}

model StockReservation {
  id          String          @id @default(cuid())
  orderId     String
  orderItemId String
  productId   String
  variantId   String?
  quantity    Int
  expiresAt   DateTime
  releasedAt  DateTime?
  orderItem   OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([expiresAt, releasedAt])
  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String   @db.VarChar(48)
  fromValue String?  @db.VarChar(80)
  toValue   String?  @db.VarChar(80)
  note      String?  @db.VarChar(500)
  actorId   String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OutboxEvent {
  id             String    @id @default(cuid())
  storeId        String
  aggregateId    String
  type           String    @db.VarChar(60)
  payload        Json
  idempotencyKey String    @unique @db.VarChar(120)
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  processedAt    DateTime?
  lastError      String?   @db.VarChar(500)
  createdAt      DateTime  @default(now())
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, processedAt, availableAt])
  @@index([aggregateId])
}

model StoreRateLimitBucket {
  id          String   @id @default(cuid())
  storeId     String
  keyHash     String   @db.VarChar(64)
  windowStart DateTime
  count       Int      @default(0)
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, keyHash, windowStart])
  @@index([windowStart])
}

model WhatsappSettings {
  storeId                   String            @id
  mode                      WhatsappMode      @default(WA_ME)
  businessNumber            String?           @db.VarChar(20)
  businessCountry           String?           @db.VarChar(2)
  productOrderButtonEnabled Boolean           @default(true)
  /// Modèle « du client à la boutique » ; variables : {prenom} {reference} {articles} {montant} {livraison}.
  customerTemplate          String?           @db.VarChar(600)
  /// Modèle « de la boutique au client » ; mêmes variables.
  storeTemplate             String?           @db.VarChar(600)
  showConfirmAfterOrder     Boolean           @default(true)
  offerWriteToCustomer      Boolean           @default(true)
  apiPhoneNumberId          String?           @db.VarChar(40)
  apiBusinessAccountId      String?           @db.VarChar(40)
  apiAccessTokenEncrypted   String?
  apiTemplateName           String?           @db.VarChar(512)
  apiTemplateLanguage       String            @default("fr") @db.VarChar(10)
  apiWebhookSecretEncrypted String?
  apiStatus                 WhatsappApiStatus @default(NOT_CONFIGURED)
  apiDisplayPhoneNumber     String?           @db.VarChar(40)
  apiVerifiedName           String?           @db.VarChar(120)
  apiLastCheckedAt          DateTime?
  apiLastError              String?           @db.VarChar(500)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  store                     Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

enum StorePageKind {
  ABOUT
  CONTACT
  FAQ
  PROMO
}

enum StorePageStatus {
  DRAFT
  PUBLISHED
}

model Activity {
  id       String  @id @default(cuid())
  slug     String  @unique @db.VarChar(60)
  label    String  @db.VarChar(80)
  position Int     @default(0)
  popular  Boolean @default(false)
  stores   Store[]
}

/// Assistant WhatsApp de la boutique : réponses guidées rédigées par le vendeur, sans IA (brief §6.15).
model StoreChatConfig {
  storeId          String   @id
  enabled          Boolean  @default(false)
  welcomeMessage   String   @db.VarChar(200)
  transferTemplate String   @db.VarChar(300)
  offHoursMessage  String?  @db.VarChar(300)
  showOnHome       Boolean  @default(true)
  showOnProduct    Boolean  @default(true)
  showOnCart       Boolean  @default(true)
  showOnCheckout   Boolean  @default(false)
  updatedAt        DateTime @updatedAt
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model StoreChatQuickReply {
  id       String  @id @default(cuid())
  storeId  String
  label    String  @db.VarChar(30)
  answer   String  @db.VarChar(500)
  position Int     @db.SmallInt
  enabled  Boolean @default(true)
  store    Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, position])
}

/// Pages éditoriales en blocs structurés : aucun HTML ni JavaScript n'est stocké (brief §6.5).
model StorePage {
  id        String          @id @default(cuid())
  storeId   String
  kind      StorePageKind
  title     String          @db.VarChar(80)
  slug      String          @db.VarChar(60)
  status    StorePageStatus @default(DRAFT)
  blocks    Json
  /// Ordre dans le menu de la boutique (0 = premier après « Boutique »).
  position  Int             @default(0) @db.SmallInt
  updatedAt DateTime        @updatedAt
  createdAt DateTime        @default(now())
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, kind])
  @@unique([storeId, slug])
}

/// Journal des actions d'administration (brief §6.13) : qui, quand, quoi, cible.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(60)
  targetType String   @db.VarChar(30)
  targetId   String   @db.VarChar(60)
  storeId    String?
  /// Détails sans donnée sensible (motif, durée…).
  details    Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType, targetId])
}

enum AdminAlertStatus {
  RESOLVED
  IGNORED
}

/// Les alertes sont calculées à partir des données ; seule la décision de l'équipe est enregistrée ici.
model AdminAlertState {
  key         String           @id @db.VarChar(160)
  status      AdminAlertStatus
  level       String           @db.VarChar(20)
  title       String           @db.VarChar(200)
  body        String           @db.VarChar(500)
  updatedById String?
  updatedAt   DateTime         @updatedAt
  createdAt   DateTime         @default(now())
  updatedBy   User?            @relation("AdminAlertStateAuthor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Avis laissé par un visiteur sur un produit ; publié seulement après validation par la boutique.
model ProductReview {
  id          String       @id @default(cuid())
  storeId     String
  productId   String
  authorName  String       @db.VarChar(60)
  /// Note de 1 à 5 (contrainte en base).
  rating      Int
  comment     String       @db.VarChar(1000)
  status      ReviewStatus @default(PENDING)
  moderatedAt DateTime?
  createdAt   DateTime     @default(now())
  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status, createdAt])
  @@index([storeId, status, createdAt])
}

/// Anciennes adresses d'une boutique (après un changement de nom) : elles redirigent vers l'adresse actuelle,
/// pour que les liens déjà partagés et les QR codes imprimés continuent de fonctionner.
model StoreSlugAlias {
  slug      String   @id @db.VarChar(40)
  storeId   String
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

/// Destination d'une image de bannière ou d'un popup quand le visiteur la touche.
enum StoreLinkType {
  NONE
  CATEGORY
  PRODUCT
  PROMO
}

/// Diaporama sous la recherche de la boutique : 4 images au maximum (vérifié par le serveur).
model StoreBanner {
  id         String           @id @default(cuid())
  storeId    String
  imageUrl   String
  altText    String           @db.VarChar(200)
  /// 0 = première image affichée.
  position   Int              @db.SmallInt
  linkType   StoreLinkType    @default(NONE)
  categoryId String?
  productId  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  store      Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  product    Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([storeId, position])
}

/// Popup d'accueil de la boutique (Marketing → Popups) : un seul actif à la fois.
model StorePopup {
  id         String           @id @default(cuid())
  storeId    String
  /// Nom interne, pour que le vendeur s'y retrouve (jamais affiché aux visiteurs).
  title      String           @db.VarChar(80)
  imageUrl   String
  altText    String           @db.VarChar(200)
  linkType   StoreLinkType    @default(NONE)
  categoryId String?
  productId  String?
  isActive   Boolean          @default(false)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  store      Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  product    Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([storeId, isActive])
}

/// Visites de la boutique publique, agrégées par jour (heure de Douala) : aucune donnée sur le visiteur.
/// Les robots évidents et les membres de la boutique ne sont pas comptés.
model StoreVisitDay {
  storeId String
  /// Jour à minuit (heure de Douala), en UTC.
  day     DateTime @db.Date
  visits  Int      @default(0)
  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, day])
  @@index([day])
}

enum SystemNotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

/// Notification technique de l'administration (cloche) : erreurs serveur, lenteurs, envois d'e-mails
/// ou tâches en échec. Les erreurs identiques (même type, même message) sont regroupées.
model SystemNotification {
  id          String                     @id @default(cuid())
  /// Empreinte « type + message » : une seule ligne par erreur identique.
  fingerprint String                     @unique @db.VarChar(64)
  type        String                     @db.VarChar(40)
  severity    SystemNotificationSeverity
  message     String                     @db.VarChar(500)
  /// Contexte sans donnée personnelle (route, méthode, durée…).
  context     Json?
  occurrences Int                        @default(1)
  firstSeenAt DateTime                   @default(now())
  lastSeenAt  DateTime                   @default(now())
  readAt      DateTime?

  @@index([readAt, lastSeenAt])
  @@index([lastSeenAt])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

/// Nature d'un message reçu : formulaire de contact, ou message d'un vendeur depuis son tableau de bord
/// (question, suggestion, avis noté sur PrestAfrik).
enum SupportTicketKind {
  CONTACT
  QUESTION
  SUGGESTION
  REVIEW
}

/// Emplacement d'une annonce de PrestAfrik dans le tableau de bord des vendeurs.
enum AnnouncementPlacement {
  CAROUSEL
  BANNER
}

/// Annonce de PrestAfrik affichée en haut du tableau de bord des vendeurs (Administration → Annonces) :
/// diaporama pleine largeur, ou bannière simple en dessous.
model PlatformAnnouncement {
  id        String                @id @default(cuid())
  placement AnnouncementPlacement
  imageUrl  String
  altText   String                @db.VarChar(160)
  /// Lien ouvert au clic (page de PrestAfrik ou adresse https) ; facultatif.
  linkUrl   String?               @db.VarChar(500)
  position  Int                   @default(0)
  active    Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([placement, active, position])
}

/// Demande d'aide (formulaire de contact du site) suivie par l'équipe PrestAfrik.
model SupportTicket {
  id             String                 @id @default(cuid())
  subject        String                 @db.VarChar(120)
  message        String                 @db.VarChar(4000)
  requesterName  String                 @db.VarChar(120)
  requesterEmail String                 @db.VarChar(254)
  requesterId    String?
  status         SupportTicketStatus    @default(OPEN)
  kind           SupportTicketKind      @default(CONTACT)
  /// Avis sur PrestAfrik : note de 1 à 5 (contrainte en base), seulement pour kind = REVIEW.
  rating         Int?                   @db.SmallInt
  /// Boutique depuis laquelle le vendeur a écrit (messages du tableau de bord).
  storeId        String?
  assignedToId   String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  requester      User?                  @relation("SupportTicketRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  assignedTo     User?                  @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  replies        SupportTicketMessage[]
  store          Store?                 @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([kind, createdAt])
}

/// Réponse de l'équipe à une demande d'aide (envoyée par e-mail au demandeur).
model SupportTicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  authorId  String?
  body      String        @db.VarChar(4000)
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}
