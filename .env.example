# PostgreSQL connection strings from your Supabase project.
# DATABASE_URL: pooled connection for the application.
# DIRECT_URL: direct connection used by Prisma migrations.
DATABASE_URL="postgresql://postgres:password@localhost:5432/prestafrik?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/prestafrik?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# In production, set this to the public HTTPS origin, e.g. https://app.example.com
BETTER_AUTH_URL="http://localhost:3000"

# Optional: key used to encrypt store secrets (WhatsApp API token, webhook secret).
# Without it, a key is derived from BETTER_AUTH_SECRET. Changing it makes saved secrets unreadable.
SECRETS_ENCRYPTION_KEY=""

# Outgoing mail via SMTP. Use port 465 with SMTP_SECURE=true, or 587 with false.
SMTP_HOST="smtp.provider-domain.cm"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="no-reply@prestafrik.cm"
SMTP_PASSWORD="set-in-your-secret-manager"
SMTP_FROM="PrestAfrik <no-reply@prestafrik.cm>"

# Set to true only when intentionally loading fictional local demo data.
ALLOW_DEMO_SEED="false"

# Configuration templates for IMAP, WhatsApp, payments, and object storage:
# see .env.production.example and docs/production-configuration.md.

# Abonnements payants (ADR-014). Absent ou "false" : PrestAfrik est gratuit, sans limite.
NEXT_PUBLIC_BILLING_ENABLED="false"
# Numéro WhatsApp public de l'équipe PrestAfrik (landing page, format +237...). Vide : contact par e-mail.
NEXT_PUBLIC_PRESTAFRIK_WHATSAPP=""

# Images des vendeurs. En local, rien à faire : elles vont dans storage/uploads.
# Pour utiliser Cloudinary (comme en production), renseignez les trois valeurs (docs/stockage-images.md).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Ou un stockage objet S3 compatible :
# OBJECT_STORAGE_ENDPOINT=""
# OBJECT_STORAGE_REGION=""
# OBJECT_STORAGE_BUCKET=""
# OBJECT_STORAGE_ACCESS_KEY_ID=""
# OBJECT_STORAGE_SECRET_ACCESS_KEY=""

# Boutiques en sous-domaine : mboa-style.prestafrik.com (ADR-024, docs/sous-domaines.md).
# Désactivé tant que le DNS et le certificat *.prestafrik.com ne sont pas en place.
FEATURE_SUBDOMAINS="false"
STORE_ROOT_DOMAIN="prestafrik.com"
# Clé partagée avec la règle Cloudflare qui transmet l'hôte d'origine (générer comme BETTER_AUTH_SECRET).
STORE_PROXY_SECRET=""

# Administration : seuil (ms) des requêtes lentes signalées dans la cloche (facultatif)
# SLOW_QUERY_MS="2000"

# Codes de vérification WhatsApp (inscription par WhatsApp, désactivée pour le moment) : voir docs/whatsapp-meta.md.
# En local, sans compte Meta : WHATSAPP_DEV_LOG_CODES="true" affiche le code dans le terminal (jamais en production).
WHATSAPP_DEV_LOG_CODES="false"
WHATSAPP_PLATFORM_PHONE_NUMBER_ID=""
WHATSAPP_PLATFORM_ACCESS_TOKEN=""
WHATSAPP_OTP_TEMPLATE_NAME="prestafrik_code"
WHATSAPP_OTP_TEMPLATE_LANGUAGE="fr"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Connexion et inscription avec Google (docs/google-oauth.md) : le bouton n'apparaît que si les deux sont renseignées.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Inscription par WhatsApp (code envoyé par l'API Meta) : désactivée pour le moment.
WHATSAPP_SIGNUP_ENABLED="false"

# Bandeau « Club des 1000 » de la page Tarifs : "off" le ferme (sans modifier le code).
CLUB_DES_1000="on"
# Preuve sociale de l'accueil : chaque compteur reste masqué sous son seuil (vraies données seulement).
SOCIAL_PROOF_MIN_STORES="50"
SOCIAL_PROOF_MIN_ORDERS="200"
SOCIAL_PROOF_MIN_CITIES="5"
SOCIAL_PROOF_MIN_LOGOS="6"
