# Copy these variable names to your hosting provider's secret manager.
# Never commit real credentials or share them in chat.

# Application
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
BETTER_AUTH_SECRET="GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
BETTER_AUTH_URL="https://app.your-domain.cm"
NODE_ENV="production"

# Business/legal identity. Replace every placeholder before public launch.
LEGAL_OPERATOR_NAME="TO_COMPLETE_LEGAL_COMPANY_OR_TRADER_NAME"
LEGAL_OPERATOR_FORM="TO_COMPLETE_LEGAL_FORM"
LEGAL_OPERATOR_ADDRESS="TO_COMPLETE_REGISTERED_OR_BUSINESS_ADDRESS_IN_CAMEROON"
LEGAL_OPERATOR_REGISTRATION="TO_COMPLETE_RCCM_OR_OTHER_APPLICABLE_REGISTRATION"
LEGAL_OPERATOR_TAX_ID="TO_COMPLETE_TAXPAYER_NUMBER_IF_APPLICABLE"
LEGAL_CONTACT_EMAIL="TO_COMPLETE_LEGAL_CONTACT_EMAIL"
LEGAL_CONTACT_PHONE="+237XXXXXXXXX"
LEGAL_HOSTING_PROVIDER="TO_COMPLETE_HOSTING_PROVIDER_AND_COUNTRY"
LEGAL_PRIVACY_CONTACT="TO_COMPLETE_PRIVACY_CONTACT"

# Outgoing email (SMTP): needed for account verification, password reset, and invites.
# TLS: port 465 usually uses implicit TLS; port 587 usually uses STARTTLS.
SMTP_HOST="smtp.your-mail-provider.example"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-sender-account"
SMTP_PASSWORD="SET_IN_HOST_SECRET_MANAGER"
SMTP_FROM="PrestAfrik <no-reply@your-domain.cm>"

# Incoming mail (IMAP): optional; only needed if the application must read a mailbox.
# IMAP is not a replacement for SMTP and is not currently consumed by the application.
IMAP_HOST="imap.your-mail-provider.example"
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER="your-mailbox"
IMAP_PASSWORD="SET_IN_HOST_SECRET_MANAGER"

# WhatsApp Business Cloud API (Meta). Requires an approved WhatsApp Business account,
# a registered phone number, an access token, and a publicly reachable HTTPS webhook.
WHATSAPP_PROVIDER="meta-cloud-api"
WHATSAPP_GRAPH_API_VERSION="vXX.X"
WHATSAPP_ACCESS_TOKEN="SET_IN_HOST_SECRET_MANAGER"
WHATSAPP_PHONE_NUMBER_ID="TO_COMPLETE"
WHATSAPP_BUSINESS_ACCOUNT_ID="TO_COMPLETE"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="SET_IN_HOST_SECRET_MANAGER"
WHATSAPP_APP_SECRET="SET_IN_HOST_SECRET_MANAGER"

# Subscription payment provider. These are preparation fields, not an active adapter.
# Choose a provider first; the provider-specific API/webhook integration is still required.
PAYMENT_PROVIDER="TO_CHOOSE"
PAYMENT_API_BASE_URL="TO_COMPLETE"
PAYMENT_PUBLIC_KEY="SET_IN_HOST_SECRET_MANAGER"
PAYMENT_SECRET_KEY="SET_IN_HOST_SECRET_MANAGER"
PAYMENT_WEBHOOK_SECRET="SET_IN_HOST_SECRET_MANAGER"
PAYMENT_CURRENCY="XAF"

# Durable image storage (S3-compatible). Required instead of local public/uploads
# when the production host uses ephemeral disks.
OBJECT_STORAGE_ENDPOINT="https://TO_COMPLETE"
OBJECT_STORAGE_REGION="TO_COMPLETE"
OBJECT_STORAGE_BUCKET="TO_COMPLETE"
OBJECT_STORAGE_ACCESS_KEY_ID="SET_IN_HOST_SECRET_MANAGER"
OBJECT_STORAGE_SECRET_ACCESS_KEY="SET_IN_HOST_SECRET_MANAGER"
OBJECT_STORAGE_PUBLIC_URL="https://TO_COMPLETE"
